# Copiar a .env y completar. Nunca commitear .env.

# Fish Audio (TTS). https://fish.audio/developers/
FISH_AUDIO_API_KEY=
# Motor de Fish Audio (header "model"): s1, s2-pro (default de la API), s2.1-pro, s2.1-pro-free...
FISH_AUDIO_MODEL=s2-pro

# Director LLM (Anthropic). Solo necesario con --director anthropic.
ANTHROPIC_API_KEY=
# Modelo para el director (por defecto claude-opus-5-5)
DIRECTOR_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (ver npm run compare-writers)
DIRECTOR_EFFORT=high

# Ruta a whisper.cpp y modelo (por defecto tools/whisper.cpp y modelo "medium")
WHISPER_CPP_PATH=tools/whisper.cpp
WHISPER_CPP_VERSION=1.5.5
WHISPER_MODEL=medium

# Carpeta de revision simple fuera del repo (npm run review). Ej.: C:/Users/<tu>/Desktop/Proyecto vocaloid/Episodios
REVIEW_DIR=

# Voz de prototipo en espanol (npm run generate -- --tts espeak --preview). Solo si espeak-ng no esta en el PATH.
# Linux: apt install espeak-ng mbrola mbrola-es3 · Windows: instalador de github.com/espeak-ng/espeak-ng
ESPEAK_NG_PATH=

# Subida con Selenium (npm run upload, docs/12_PUBLICACION.md)
# Navegador: Chromium (o Chrome). Vacio: se busca Chromium en las rutas habituales y si no, Chrome.
UPLOAD_BROWSER=
# Perfil con las sesiones iniciadas a mano (npm run upload -- --login). Vacio: .cache/upload-profile
UPLOAD_PROFILE_DIR=
# chromedriver propio (opcional; por defecto Selenium Manager descarga el que corresponde)
CHROMEDRIVER_PATH=
