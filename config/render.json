{
  "$schema": "../schemas/render.schema.json",
  "titleCard": {
    "enabled": true,
    "y": 240,
    "maxWidth": 860,
    "fontSize": 64,
    "maxLines": 2,
    "lineHeight": 1.1,
    "paddingX": 28,
    "paddingY": 16,
    "radius": 22,
    "background": "rgba(17,17,17,0.72)",
    "textColor": "#FFFFFF",
    "emphasisColor": "#FFE14D",
    "minMs": 1500,
    "maxMs": 6000,
    "popInMs": 200,
    "fadeOutMs": 250,
    "reserveVisualArea": true
  },
  "watermark": {
    "enabled": true,
    "handles": {
      "es": "@tetociencia",
      "default": "@tetociencia"
    },
    "colors": [
      "#E5323F",
      "#E285B2",
      "#39C5BB",
      "#F6C744",
      "#3D7BFF"
    ],
    "opacity": 0.6,
    "fontSize": 56,
    "charWidthEm": 0.58,
    "speedPxPerSec": 210,
    "margin": 12,
    "start": [
      0.15,
      0.35
    ]
  },
  "video": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "aspect": "9:16",
    "codec": "h264",
    "crf": 20,
    "pixelFormat": "yuv420p",
    "audioCodec": "aac",
    "audioBitrate": "192k"
  },
  "duration": {
    "minMs": 60000,
    "maxMs": 120000,
    "targetMs": 85000
  },
  "safeArea": {
    "top": 220,
    "bottom": 420,
    "left": 60,
    "right": 140
  },
  "layout": {
    "visualArea": {
      "x": 90,
      "y": 260,
      "width": 850,
      "height": 640
    },
    "listenerScaleFactor": 0.78,
    "listenerDim": 0.25,
    "maxCharactersOnScreen": 3,
    "characterMarginX": 20
  },
  "captions": {
    "fontFamily": "Montserrat",
    "fontWeight": 900,
    "fontSize": 78,
    "lineHeight": 1.15,
    "maxLines": 2,
    "centerY": 1040,
    "maxWidth": 860,
    "strokeWidth": 12,
    "strokeColor": "#111111",
    "inactiveColor": "#FFFFFF",
    "emphasisScale": 1.18,
    "combineTokensWithinMs": 900,
    "maxWordsPerPage": 6,
    "avgCharWidthEm": 0.62,
    "keepTogether": [
      "Me gusta",
      "Papu papu"
    ]
  },
  "timing": {
    "leadInMs": 60,
    "gapBetweenBlocksMs": 150,
    "minGapMs": 80,
    "maxGapMs": 900,
    "tailMs": 500,
    "maxTailMs": 6000,
    "memeSceneMs": 700,
    "pauseSceneMs": 700,
    "estimatedWordsPerSecond": 2.6,
    "minAvatarChangeIntervalMs": 1000,
    "avatarVariantIntervalMs": 2000
  },
  "audio": {
    "sampleRate": 48000,
    "loudnessLufs": -14,
    "truePeakDb": -1.5,
    "finalLimiterDb": -1.5,
    "voiceBlockLufs": -20,
    "voiceTempo": 1.1,
    "voicePauseCap": { "maxMs": 600, "keepMs": 250, "noiseDb": -40 },
    "greeting": {
      "text": "¡Papu papu!",
      "gapMs": 150
    },
    "music": {
      "lufs": -31,
      "fadeInMs": 400,
      "fadeOutMs": 1500,
      "duck": {
        "threshold": 0.015,
        "ratio": 8,
        "attackMs": 15,
        "releaseMs": 350
      }
    },
    "sfxVolume": 0.55,
    "backgroundVideoVolume": 0
  },
  "background": {
    "dim": 0.35,
    "fallbackColor": "#141420",
    "styles": {
      "analitico": {
        "dim": 0.35,
        "palette": { "darken": 0.66, "glow": 0.32, "grid": 0.09, "particles": 6, "particleOpacity": 0.2, "particleBlur": 1, "transitionMs": 1000 }
      },
      "suave": {
        "dim": 0.2,
        "blurPx": 9,
        "saturate": 1.12,
        "motion": { "zoomFrom": 1.08, "zoomTo": 1.16, "driftPx": 30, "periodSec": 16 },
        "palette": { "darken": 0.5, "glow": 0.55, "grid": 0.05, "particles": 16, "particleOpacity": 0.34, "particleBlur": 2.5, "transitionMs": 800 }
      }
    }
  },
  "events": {
    "cameraZoom": {
      "scale": 1.12,
      "durationMs": 900
    },
    "cameraShake": {
      "intensity": 18,
      "durationMs": 450
    },
    "memeExplosion": {
      "durationMs": 1700,
      "flashMs": 150,
      "punchScale": 1.15,
      "defaultMeme": "meme_boom",
      "defaultSfx": "sfx_boom",
      "cutAtMs": 850,
      "gifPlaybackRate": 1.7
    },
    "subtitleEmphasis": {
      "durationMs": 0
    },
    "visual": {
      "popInMs": 250,
      "popOutMs": 200,
      "sfx": {
        "id": "sfx_pop",
        "volume": 0.35,
        "minGapMs": 700
      }
    },
    "broll": {
      "clipMs": 3500,
      "minMs": 1000
    },
    "sticker": {
      "durationMs": 1300,
      "size": 330,
      "popInMs": 180,
      "popOutMs": 150,
      "tiltDeg": 12,
      "inset": 12,
      "sfx": "sfx_pop",
      "volume": 0.4
    }
  }
}
