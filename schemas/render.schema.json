{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://short-video-engine.local/schemas/render.schema.json",
  "title": "RenderConfig",
  "type": "object",
  "required": ["video", "duration", "safeArea", "layout", "captions", "timing", "audio", "background", "events"],
  "properties": {
    "$schema": { "type": "string" },
    "watermark": {
      "description": "Marca de agua rebotando estilo DVD; el handle depende del idioma del video.",
      "type": "object",
      "additionalProperties": false,
      "required": ["handles", "colors", "opacity", "fontSize", "charWidthEm", "speedPxPerSec", "margin", "start"],
      "properties": {
        "enabled": { "type": "boolean" },
        "handles": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
        "colors": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "fontSize": { "type": "number", "exclusiveMinimum": 0 },
        "charWidthEm": { "type": "number", "exclusiveMinimum": 0 },
        "speedPxPerSec": { "type": "number", "minimum": 0 },
        "margin": { "type": "number", "minimum": 0 },
        "start": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0, "maximum": 1 } }
      }
    },
    "video": {
      "type": "object",
      "required": ["width", "height", "fps", "aspect", "codec", "crf", "pixelFormat", "audioCodec", "audioBitrate"],
      "properties": {
        "width": { "const": 1080 },
        "height": { "const": 1920 },
        "fps": { "type": "integer", "enum": [24, 25, 30, 60] },
        "aspect": { "const": "9:16" },
        "codec": { "enum": ["h264", "h265"] },
        "crf": { "type": "integer", "minimum": 1, "maximum": 51 },
        "pixelFormat": { "type": "string" },
        "audioCodec": { "enum": ["aac", "mp3"] },
        "audioBitrate": { "type": "string" }
      }
    },
    "duration": {
      "type": "object",
      "required": ["minMs", "maxMs", "targetMs"],
      "properties": {
        "minMs": { "type": "integer", "minimum": 0 },
        "maxMs": { "type": "integer", "minimum": 1 },
        "targetMs": { "type": "integer", "minimum": 1 }
      }
    },
    "safeArea": {
      "type": "object",
      "required": ["top", "bottom", "left", "right"],
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "layout": { "type": "object" },
    "captions": { "type": "object" },
    "timing": { "type": "object" },
    "audio": { "type": "object" },
    "background": { "type": "object" },
    "events": { "type": "object" }
  }
}
