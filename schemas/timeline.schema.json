{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://short-video-engine.local/schemas/timeline.schema.json",
  "title": "Timeline",
  "description": "Contrato entre la inteligencia narrativa (director) y el renderizador. JSON puro, sin funciones. Los tiempos son milisegundos absolutos salvo atMs de eventos (relativo al inicio de la escena).",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "scenes"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "const": 1 },
    "meta": { "$ref": "#/definitions/meta" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/scene" }
    },
    "captions": {
      "description": "Palabras con timestamps absolutos (salida de transcripcion + alineado). Si falta, el render estima captions a partir de dialogue.",
      "type": "array",
      "items": { "$ref": "#/definitions/captionWord" }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_\\-]*$", "maxLength": 64 },
    "ms": { "type": "integer", "minimum": 0 },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "durationTargetSec", "aspect", "fps"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "durationTargetSec": { "type": "number", "minimum": 1, "maximum": 180 },
        "aspect": { "type": "string", "const": "9:16" },
        "fps": { "type": "integer", "enum": [24, 25, 30, 60] },
        "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
        "background": {
          "description": "ID de asset (background_video/background_image) o ruta relativa al repo de un archivo del proyecto.",
          "type": "string",
          "minLength": 1
        },
        "music": {
          "description": "ID de asset de tipo music. Se mezcla en la pista maestra, en loop, con ducking bajo la voz.",
          "type": "string",
          "minLength": 1
        },
        "broll": {
          "description": "IDs de assets broll (videos/GIF) que rellenan el area de visuales cuando no hay ningun visual ni meme. Lista vacia = sin relleno.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "timingSource": {
          "description": "estimated: tiempos estimados por el director. audio: tiempos reajustados con el audio real (autoridad temporal).",
          "type": "string",
          "enum": ["estimated", "audio", "manual"]
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["master", "durationMs"],
          "properties": {
            "master": { "type": "string", "minLength": 1 },
            "durationMs": { "$ref": "#/definitions/ms" }
          }
        },
        "project": { "type": "string" },
        "generator": { "type": "string" }
      }
    },
    "section": {
      "type": "string",
      "enum": ["hook", "reaction", "context", "development", "visual", "punchline", "closing"]
    },
    "onScreen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character"],
      "properties": {
        "character": { "$ref": "#/definitions/id" },
        "avatar": { "type": "string", "minLength": 1 }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startMs", "endMs"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "section": { "$ref": "#/definitions/section" },
        "startMs": { "$ref": "#/definitions/ms" },
        "endMs": { "$ref": "#/definitions/ms" },
        "character": { "$ref": "#/definitions/id" },
        "avatar": { "type": "string", "minLength": 1 },
        "dialogue": { "type": "string", "minLength": 1, "maxLength": 600 },
        "listeners": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/definitions/onScreen" }
        },
        "crowd": {
          "description": "Permite mas personajes en pantalla que layout.maxCharactersOnScreen. Solo si el evento lo justifica.",
          "type": "boolean"
        },
        "visuals": {
          "description": "Atajo: muestra estos visuales durante toda la escena.",
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/definitions/id" }
        },
        "events": {
          "type": "array",
          "items": {
            "oneOf": [{ "$ref": "#/definitions/eventShorthand" }, { "$ref": "#/definitions/event" }]
          }
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["src", "durationMs"],
          "properties": {
            "src": { "type": "string", "minLength": 1 },
            "offsetMs": { "$ref": "#/definitions/ms" },
            "durationMs": { "$ref": "#/definitions/ms" }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "eventType": {
      "type": "string",
      "enum": [
        "character_reaction",
        "visual_show",
        "visual_hide",
        "camera_zoom",
        "camera_shake",
        "meme_explosion",
        "subtitle_emphasis",
        "pause",
        "sfx"
      ]
    },
    "eventShorthand": {
      "description": "Forma corta: solo el tipo, se aplica al inicio de la escena con parametros por defecto.",
      "type": "string",
      "enum": ["camera_zoom", "camera_shake", "meme_explosion", "subtitle_emphasis", "pause"]
    },
    "anchor": {
      "type": "object",
      "properties": {
        "atMs": { "description": "Relativo al inicio de la escena.", "$ref": "#/definitions/ms" },
        "atWord": { "description": "Indice (0-based) de palabra del dialogo de la escena. Se convierte a atMs con el audio real.", "type": "integer", "minimum": 0 }
      }
    },
    "event": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "$ref": "#/definitions/eventType" } },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "character_reaction" } } },
          "then": {
            "additionalProperties": false,
            "required": ["type", "character", "avatar"],
            "properties": {
              "type": true, "atMs": true, "atWord": true,
              "character": { "$ref": "#/definitions/id" },
              "avatar": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "visual_show" } } },
          "then": {
            "additionalProperties": false,
            "required": ["type", "visual"],
            "properties": {
              "type": true, "atMs": true, "atWord": true,
              "visual": { "$ref": "#/definitions/id" },
              "durationMs": { "type": "integer", "minimum": 100 },
              "slot": { "type": "string", "enum": ["auto", "full", "left", "right", "top", "bottom"] }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "visual_hide" } } },
          "then": {
            "additionalProperties": false,
            "required": ["type", "visual"],
            "properties": {
              "type": true, "atMs": true, "atWord": true,
              "visual": { "$ref": "#/definitions/id" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "camera_zoom" } } },
          "then": {
            "additionalProperties": false,
            "properties": {
              "type": true, "atMs": true, "atWord": true,
              "durationMs": { "type": "integer", "minimum": 100, "maximum": 10000 },
              "scale": { "type": "number", "minimum": 1, "maximum": 1.5 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "camera_shake" } } },
          "then": {
            "additionalProperties": false,
            "properties": {
              "type": true, "atMs": true, "atWord": true,
              "durationMs": { "type": "integer", "minimum": 50, "maximum": 3000 },
              "intensity": { "type": "number", "minimum": 1, "maximum": 60 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "meme_explosion" } } },
          "then": {
            "additionalProperties": false,
            "properties": {
              "type": true, "atMs": true, "atWord": true,
              "meme": { "$ref": "#/definitions/id" },
              "sfx": { "$ref": "#/definitions/id" },
              "durationMs": { "type": "integer", "minimum": 300, "maximum": 5000 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "subtitle_emphasis" } } },
          "then": {
            "additionalProperties": false,
            "properties": {
              "type": true, "atMs": true, "atWord": true,
              "words": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
              "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "pause" } } },
          "then": {
            "additionalProperties": false,
            "properties": {
              "type": true, "atMs": true, "atWord": true,
              "durationMs": { "type": "integer", "minimum": 100, "maximum": 3000 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "sfx" } } },
          "then": {
            "additionalProperties": false,
            "required": ["type", "sfx"],
            "properties": {
              "type": true, "atMs": true, "atWord": true,
              "sfx": { "$ref": "#/definitions/id" },
              "volume": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      ]
    },
    "captionWord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "startMs", "endMs", "character"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "startMs": { "$ref": "#/definitions/ms" },
        "endMs": { "$ref": "#/definitions/ms" },
        "character": { "$ref": "#/definitions/id" },
        "sceneId": { "$ref": "#/definitions/id" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
