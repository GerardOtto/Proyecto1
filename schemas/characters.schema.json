{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://short-video-engine.local/schemas/characters.schema.json",
  "title": "Characters",
  "description": "Identidad visual y de voz de cada personaje. Ningun guion puede cambiar estos valores.",
  "type": "object",
  "additionalProperties": false,
  "required": ["characters"],
  "properties": {
    "$schema": { "type": "string" },
    "characters": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/definitions/character" }
    }
  },
  "definitions": {
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "subtitleColor", "defaultScale", "anchor", "avatarDir", "reactions"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "subtitleColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "defaultScale": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "anchor": { "type": "string", "enum": ["bottom-left", "bottom-right"] },
        "avatarDir": { "type": "string", "minLength": 1 },
        "reactions": {
          "description": "Reaccion canonica (config/reactions.json) -> nombre de archivo dentro de avatarDir.",
          "type": "object",
          "minProperties": 1,
          "required": ["neutral"],
          "additionalProperties": { "type": "string", "pattern": "^[^/\\\\]+\\.(png|jpg|jpeg|webp|svg)$" }
        },
        "variants": {
          "description": "Imagenes extra de la MISMA reaccion (reaccion canonica -> archivos). Mientras el personaje habla, el plan alterna la imagen principal y sus variantes cada timing.avatarVariantIntervalMs.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[^/\\\\]+\\.(png|jpg|jpeg|webp|svg)$" }
          }
        },
        "voice": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fish": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "referenceId": { "type": "string" },
                "speed": { "type": "number", "minimum": 0.5, "maximum": 2 },
                "volume": { "type": "number" }
              }
            },
            "flite": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "voice": { "type": "string" } }
            },
            "espeak": {
              "description": "Voz de prototipo en espanol (espeak-ng, con MBROLA si esta instalado). Solo para borradores (--tts espeak, ADR 0013).",
              "type": "object",
              "additionalProperties": false,
              "required": ["voice", "pitch", "speed"],
              "properties": {
                "voice": { "type": "string", "minLength": 1 },
                "pitch": { "type": "integer", "minimum": 0, "maximum": 99 },
                "speed": { "type": "integer", "minimum": 80, "maximum": 450 }
              }
            },
            "greeting": {
              "description": "Audio reutilizable del saludo recurrente (audio.greeting.text en render.json), ruta relativa al repo.",
              "type": "string",
              "pattern": "^[^\\\\]+\\.(wav|mp3|m4a|ogg|flac)$"
            },
            "mute": {
              "description": "Personaje mudo (ADR 0011): nunca tiene dialogo; aparece como listener y se expresa con su SFX de firma.",
              "type": "boolean"
            },
            "signatureSfx": {
              "description": "Id del asset sfx que funciona como su voz/firma; solo debe sonar con el personaje en pantalla.",
              "type": "string"
            }
          }
        },
        "license": { "$ref": "assets.schema.json#/definitions/licenseInfo" }
      }
    }
  }
}
