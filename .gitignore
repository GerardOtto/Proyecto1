node_modules/
.cache/
output/*
!output/.gitkeep
.env
.env.local
*.log
.DS_Store

# Musica de fondo: no redistribuible (repo publico). Catalogo y archivos solo en local.
assets/music/*
!assets/music/README.md
config/assets.local.json

# Saludo recurrente por personaje (voz generada en Fish Audio): solo en local.
assets/voice/*
!assets/voice/README.md

# Binarios de whisper.cpp y modelos (se instalan con `npm run whisper:install`)
tools/whisper.cpp/
tools/models/

# Artefactos generados por el pipeline dentro de cada proyecto
projects/*/audio/
projects/*/transcript/
projects/*/timeline.json
projects/*/timeline.draft.json
projects/*/render-plan.json
projects/*/report.json
# El timeline manual de ejemplo si se versiona
!projects/manual_001/timeline.json

# Autopiloto: volcados de noticias (se regeneran en cada corrida)
projects/_autopilot/news-*.json
